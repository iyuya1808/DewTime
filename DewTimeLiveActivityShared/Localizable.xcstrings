    "tutorial.step.aquarium_gacha.message": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水槽をタップして餌を落としましょう。魚が食べたタイミングで新しい仲間が誕生し、図鑑に登録されます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the aquarium to drop feed. When fish eat, a new companion may join and be added to your collection."
          }
        }
      }
    },
    "tutorial.step.aquarium_gacha.title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "餌で仲間を増やす"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grow your school with feed"
          }
        }
      }
    },
    "tutorial.step.collection.message": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "獲得した魚種は図鑑に記録されます。まだ出会っていない魚はシルエットで表示されます。水槽レベルが上がると、より珍しい魚が出現します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fish species you meet are recorded in the collection. Unseen species appear as silhouettes. Higher aquarium levels unlock rarer fish."
          }
        }
      }
    },
    "tutorial.step.collection.title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図鑑を埋めよう"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill your collection"
          }
        }
      }
    },
    "tutorial.step.profile_records.message": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出発記録をカレンダーで確認できます。実績を達成すると餌がもらえます。通知の変更は右上の歯車から行えます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View departure records on the calendar. Achievements can reward feed. Change notifications from the gear icon."
          }
        }
      }
    },
    "tutorial.step.profile_records.title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録と実績"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records & achievements"
          }
        }
      }
    },
    "tutorial.step.rewards.message": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンタイム出発で「しずく +1」と「餌 +1」を獲得できます。しずくは水槽の成長に、餌は水槽タブで魚を呼び寄せるのに使います。遅刻すると報酬はありません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-time departures earn \"Dew Drop +1\" and \"Feed +1\". Dew Drops grow your aquarium; feed attracts fish in the Aquarium tab. No rewards if you're late."
          }
        }
      }
    },
    "tutorial.step.rewards.title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しずくと餌"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dew Drops & feed"
          }
        }
      }
    },
    "tutorial.step.timer_depart.message": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「スタート」で準備を始めます。時間内に「いってきます」を押すと、残った水を水槽へ届けられます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Start to begin. Press \"I'm off!\" on time to send remaining water to your aquarium."
          }
        }
      }
    },
    "tutorial.step.timer_depart.title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出発で水槽へ届ける"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depart to fill the aquarium"
          }
        }
      }
    },
    "tutorial.step.timer_water.message": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タンクをスワイプして出発までの時間を設定します。水が多いほど余裕があり、準備が順調なほど水が残ります。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe the tank to set time until departure. More water means more time; steady prep keeps water in the tank."
          }
        }
      }
    },
    "tutorial.step.timer_water.title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水で時間がわかる"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See time in the water"
          }
        }
      }
    },
    "widget.description": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
