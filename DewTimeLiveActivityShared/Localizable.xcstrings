    "tutorial.step.collection.message" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fish species you meet are recorded in the collection. Unseen species appear as silhouettes. Higher aquarium levels unlock rarer fish."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "獲得した魚種は図鑑に記録されます。まだ出会っていない魚はシルエットで表示されます。水槽レベルが上がると、より珍しい魚が出現します。"
          }
        }
      }
    },
