        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを連携すると、毎朝の水やりデータや水槽・図鑑の記録を安全に保存し、機種変更時にも引き継ぐことができます。"
          }
        }
      }
