        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On-time departures earn \"Dew Drop +1\" and \"Feed +1\". Dew Drops grow your aquarium; feed attracts fish in the Aquarium tab. No rewards if you're late."
