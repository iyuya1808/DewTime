    "tutorial.step.aquarium_gacha.message" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the aquarium to drop feed. When fish eat, a new companion may join and be added to your collection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水槽をタップして餌を落としましょう。魚が食べたタイミングで新しい仲間が誕生し、図鑑に登録されます。"
          }
        }
      }
    },
    "tutorial.step.aquarium_gacha.title" : {
      "extractionState" : "stale",
